{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://schemas.rvig.nl/brp/berichten/rechtspraak/2026Q4",
  "$defs": {
    "rechtsfeitMinderJarigGezag": {
      "title": "Rechtsfeit",
      "description": "Uitspraken van rechtbanken die betrekking hebben op het gezag over een minderjarige",
      "type": "object",
      "properties": {
        "rechtsfeitId": {
          "$ref": "#/$defs/rechtsfeitId"
        },
        "gezagscategorie": {
          "type": "string",
          "maxLength": 50
        },
        "gezagscode": {
          "type": "string",
          "maxLength": 255
        },
        "beslissingstekst": {
          "type": "string",
          "maxLength": 2000
        },
        "beslissingsdatum": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "registratiedatum": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "vorigeRechtsfeit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rechtsfeitId"
          }
        },
        "rechtbank": {
          "type": "string",
          "maxLength": 120
        }
      },
      "required": [
        "rechtsfeitId",
        "gezagscategorie",
        "gezagscode",
        "beslissingstekst",
        "beslissingsdatum",
        "registratiedatum",
        "rechtbank"
      ]
    },
    "rechtsfeitId": {
      "title": "Rechtsfeit ID",
      "description": "Identificatienummer van een rechtsfeit",
      "type": "string",
      "maxLength": 50
    },
    "aantekening": {
      "title": "Aantekening",
      "description": "Uitspraken van rechtbanken die betrekking hebben op het gezag over een minderjarige",
      "type": "object",
      "properties": {
        "ingangsdatum": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "beslissingsdatum": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "beslissendeInstantie": {
          "type": "string",
          "maxLength": 120
        },
        "beslissingscategorie": {
          "type": "string",
          "maxLength": 50
        },
        "beslissingsnaam": {
          "type": "string",
          "maxLength": 255
        },
        "beslissingstekst": {
          "type": "string",
          "maxLength": 2000
        },
        "registratiedatum": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        }
      },
      "required": [
        "beslissingsdatum",
        "beslissingstekst",
        "registratiedatum"
      ]
    },
    "minderjarige": {
      "title": "Minderjarige",
      "description": "Gegevens over de minderjarige waarop de inhoud van het Og21-bericht betrekking heeft",
      "type": "object",
      "properties": {
        "burgerservicenummer": {
          "$ref": "persoonslijst.schema.json#/$defs/E0120"
        }
      },
      "required": ["burgerservicenummer"]
    },
    "registerkaart": {
      "title": "Registerkaart",
      "description": "Gegevens over de registerkaart uit het Centraal Gezagsregister waaraan de inhoud van het Og21-bericht is ontleend",
      "type": "object",
      "properties": {
        "registerkaartnummer": {
          "type": "string",
          "pattern": "^[0-9]{4}_[0-9]{8}$"
        }
      },
      "required": ["registerkaartnummer"]
    },
    "uittreksel": {
      "title": "Uittreksel",
      "description": "bevat gegevens over het uittreksel uit het Centraal Gezagsregister waarop de inhoud van het Og21-bericht is gebaseerd.",
      "type": "object",
      "properties": {
        "aangemaaktOp": {
          "$ref": "berichten.schema.json#/$defs/berichtkoppen/$defs/datumTijd"
        },
        "verstrekkendeInstantie": {
          "type": "string",
          "maxLength": 120
        },
        "toelichting": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "aangemaaktOp",
        "verstrekkendeInstantie"
      ]
    }
  }
}
